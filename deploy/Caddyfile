# MusicVJN reverse proxy + automatic HTTPS.
#
# Caddy fetches and renews Let's Encrypt certs automatically — just point the
# DNS A records for musicvjn.com and api.musicvjn.com at this server's IP.
#
# Install:  sudo apt install caddy   (or the official Caddy repo)
# Run:      sudo caddy run --config /home/ubuntu/Music_Practice_Companion/deploy/Caddyfile
# Or copy to /etc/caddy/Caddyfile and `sudo systemctl reload caddy`.

# --- API: TLS terminates here, proxies to uvicorn on :8000 ---
api.musicvjn.com {
	encode gzip zstd

	# Cap request bodies as defense-in-depth (the app also enforces MAX_UPLOAD_MB).
	request_body {
		max_size 30MB
	}

	reverse_proxy 127.0.0.1:8000

	# Serve generated plot/artifact PNGs directly (faster than through uvicorn).
	handle_path /artifacts/* {
		root * /home/ubuntu/Music_Practice_Companion/api/app/outputs/sessions
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# --- Web app: static Expo web export ---
musicvjn.com, www.musicvjn.com {
	encode gzip zstd
	root * /var/www/musicvjn
	try_files {path} /index.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}
}
