# Copy to .env and fill in real values. NEVER commit .env.
# Generate SECRET_KEY with: openssl rand -hex 32
DATABASE_HOSTNAME=localhost
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme
DATABASE_PORT=5432
DATABASE_NAME=musicPracticeCompanion
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Analysis pipeline
MAX_UPLOAD_MB=25
SESSIONS_DIR=app/outputs/sessions

# Comma-separated list of allowed CORS origins
# Production example: https://musicvjn.com,https://www.musicvjn.com
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Password reset + email (leave RESEND_API_KEY blank to log emails in dev)
RESEND_API_KEY=
EMAIL_FROM=MusicVJN <noreply@musicvjn.com>
FRONTEND_URL=http://localhost:8081
RESET_TOKEN_EXPIRE_MINUTES=30

# Error monitoring (blank = disabled). Get a DSN from sentry.io
SENTRY_DSN=
